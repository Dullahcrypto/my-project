# Required
TELEGRAM_TOKEN=your_bot_token_from_botfather
CHAT_ID=your_telegram_chat_id

# Optional — faster than the public endpoint, less rate limiting
# Get a free key at helius.dev or quicknode.com
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Tunable thresholds (defaults shown)
SPIKE_MULTIPLIER=5.0        # alert if 5-min vol > N× expected rate
MIN_5MIN_VOL=20000          # minimum $20k 5-min volume
MIN_LIQUIDITY_USD=10000     # minimum $10k liquidity
MAX_WHALE_PCT=60            # skip if top-10 holders own >60%
MAX_RUG_SCORE=500           # skip if RugCheck score_normalised >500
MIN_LP_LOCKED_PCT=50        # skip if LP lock <50%
MAX_TOKEN_AGE_HOURS=1       # only alert on pairs listed within 1 hour
ALERT_COOLDOWN_MIN=30       # don't re-alert same pair for 30 min
CHECK_INTERVAL_SEC=45       # seconds between full scan cycles
HEARTBEAT_INTERVAL=3600     # seconds between heartbeat messages
