{
  "name": "neuromed-video",
  "private": true,
  "version": "1.0.0",
  "description": "Neuromed Clinic motion-design explainer (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render:vertical": "remotion render NeuromedVertical out/neuromed-9x16.mp4 --codec=h264 --crf=18",
    "render:wide": "remotion render NeuromedWide out/neuromed-16x9.mp4 --codec=h264 --crf=18",
    "render": "npm run render:vertical && npm run render:wide",
    "stills": "node render-stills.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535"
  }
}
